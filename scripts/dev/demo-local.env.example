# =============================================================================
# scripts/dev/demo-local.env.example — a local platform demo (DEMO mode)
# =============================================================================
# The minimal environment to run the built API and web as a demo instance on one
# SQLite file, with no Trigger.dev, no Ever Works Git and no mail. Operator guide:
# docs/guides/demo-mode.md. No secret is in this file: fill the three blanks below
# with throwaway values that never leave your machine.
#
# Boot (from the repo root, after `pnpm install --frozen-lockfile && pnpm build`):
#
#   cp -n scripts/dev/demo-local.env.example apps/api/.env   # git-ignored; never overwrites one; fill the secrets
#   (cd apps/api && node dist/main)                       # reads apps/api/.env itself
#   (set -a && . apps/api/.env && set +a && cd apps/web && PORT=3000 NODE_ENV=production npx next start)
#
# The API resolves DATABASE_PATH against its working directory (apps/api), so
# the file lands in apps/api/data/, which is git-ignored.
#
# What works locally: "Start the demo" on /login mints a sandbox and seeds it;
# the strip, the recorded Goal, the chat and the blocked routes (DEMO_DISABLED)
# all show. What does not: live AI (no OpenRouter key) and Generate (git storage
# is off, so no repository can be created).
#
# E2E: apps/web/e2e/demo-mode.spec.ts runs against this instance with E2E_DEMO=1.
# =============================================================================

# --- Demo mode (read by the API; the web asks GET /api/config) ---------------
DEMO=true
# Every sandbox is seeded with a Project Work; the API refuses to boot without it.
EVER_WORKS_PROJECT_WORKS_ENABLED=true
# Optional: the e2e suite creates two sandboxes per run, and the default is 5 an
# hour per IP. Raise it while re-running the suite locally.
# DEMO_CREATE_PER_IP_PER_HOUR=50

# --- Database: one SQLite file, schema from the entities ----------------------
DATABASE_TYPE=sqlite
DATABASE_PATH=./data/demo.sqlite
DATABASE_AUTOMIGRATE=true
RUN_MIGRATIONS=false

# --- Off locally ---------------------------------------------------------------
MAILER_PROVIDER=none
TRIGGER_ENABLED=false
STORAGE_EVER_WORKS_GIT_ENABLED=false

# --- AI: free OpenRouter models only (an id that does not end in :free fails closed)
# No PLUGIN_OPENROUTER_API_KEY here: live AI is not exercised locally.
PLUGIN_OPENROUTER_DEFAULT_MODEL=google/gemma-4-31b-it:free
PLUGIN_OPENROUTER_SIMPLE_MODEL=inclusionai/ling-3.2-flash:free
PLUGIN_OPENROUTER_MEDIUM_MODEL=google/gemma-4-31b-it:free
PLUGIN_OPENROUTER_COMPLEX_MODEL=nvidia/nemotron-3.5-super-vl:free

# --- Ports and origins (change together) ----------------------------------------
PORT=3100
WEB_URL=http://localhost:3000
NEXT_PUBLIC_WEB_URL=http://localhost:3000
# The web's server-side calls go here (it appends /api).
API_URL=http://localhost:3100
ALLOWED_ORIGINS=http://localhost:3000
AUTH_URL=http://localhost:3100/api/internal/auth-runtime

# --- Secrets: throwaway local values, at least 32 characters ---------------------
# Generate each with: openssl rand -base64 48
# AUTH_SECRET is shared by the API (sessions) and the web (the session cookie).
AUTH_SECRET=
PLATFORM_ENCRYPTION_KEY=
# Encrypts plugin secret settings at rest: 32 bytes as hex, NOT base64 (openssl rand -hex 32).
# Left empty, they are stored as plaintext (the API logs a warning).
PLUGIN_SECRET_ENCRYPTION_KEY=
