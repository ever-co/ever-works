// Ever Works directory hub — Cloudflare Worker configuration.
//
// Live at https://directories.ever.works (phase 1 of docs/specs/features/directory-hub/plan.md, owner's go
// 2026-11-21). Deploys need a board claim (workspace MAINTENANCE.md). There is no workers.dev URL and no preview URL:
// the custom domain below is the only way in.
{
	"name": "ever-works-directory-hub",
	"main": "src/worker.ts",
	"compatibility_date": "2026-11-01",
	"workers_dev": false,
	"preview_urls": false,
	// Workers Logs keeps only the hub's own console lines. Invocation logs are off: they would store every caller's IP
	// (`cf-connecting-ip`, `x-real-ip`), location and request URL, and the owner allows logging zero-result query text
	// only (2026-11-26). Cloudflare still attaches the request method, path and URL to each console line.
	"observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },
	"vars": {
		// The Directory Registry document (spec FR-1), kept in the catalog repo ever-works/directory-registry.
		"REGISTRY_URL": "https://raw.githubusercontent.com/ever-works/directory-registry/main/registry.json",
		"HUB_URL": "https://directories.ever.works",
		// Route-served directories (src/routing.ts): host -> the service binding below that reaches its Worker.
		"ROUTE_SERVED": { "rmm.ever.works": "DIR_RMM" }
	},
	// A same-zone fetch() reaches directories on Workers Custom Domains, but skips Workers on routes (Cloudflare 522).
	// The zone is at its limit of 100 Custom Domains, so directories past it are route-served and need one binding
	// each, plus a ROUTE_SERVED entry above.
	"services": [{ "binding": "DIR_RMM", "service": "ew-rmm" }],
	// A Workers Custom Domain (not a route): the directories are Workers on custom domains of the same zone, and
	// same-zone fetch() to a custom domain reaches the target Worker without a service binding.
	"routes": [{ "pattern": "directories.ever.works", "custom_domain": true }]
}
