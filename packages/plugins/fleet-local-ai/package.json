{
	"name": "@ever-works/fleet-local-ai-plugin",
	"version": "1.0.0",
	"description": "Local AI on your computers — an AI provider that runs every request on the local model servers of your own fleet nodes (llama-swap, Ollama, LM Studio, vLLM, any OpenAI-compatible server), for free",
	"author": {
		"name": "Ever Co. LTD",
		"email": "ever@ever.co",
		"url": "https://ever.co"
	},
	"license": "AGPL-3.0",
	"private": false,
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc --noEmit && tsup",
		"dev": "tsup --watch",
		"clean": "rm -rf dist",
		"type-check": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@ever-works/contracts": "workspace:*",
		"@ever-works/plugin": "workspace:*",
		"@langchain/core": "^1.3.0",
		"@langchain/openai": "^1.7.1",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@ai-sdk/openai-compatible": "^2.0.87",
		"@types/node": "^26.6.4",
		"ai": "^6.0.316",
		"tsup": "^8.0.0",
		"typescript": "^5.9.3",
		"vitest": "^5.0.5"
	},
	"everworks": {
		"plugin": {
			"id": "fleet-local-ai",
			"name": "Local AI on your computers",
			"version": "1.0.0",
			"category": "ai-provider",
			"capabilities": [
				"ai-provider"
			],
			"description": "Runs AI requests on the local model servers of your own computers (fleet nodes with local AI) — no API key, no per-token cost",
			"author": {
				"name": "Ever Works Team"
			},
			"license": "AGPL-3.0",
			"builtIn": true,
			"autoEnable": false,
			"distribution": "core",
			"visibility": "public"
		}
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	}
}
